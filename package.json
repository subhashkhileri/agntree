    "submenus": [
      {
        "id": "agntree.newSession",
        "label": "New Session",
        "icon": "$(comment-add)"
      },
      {
        "id": "agntree.newSessionContext",
        "label": "New Session",
        "icon": "$(comment-add)"
      }
    ],
    "keybindings": [
      {
        "command": "agntree.showStarredSessions",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      }
    ],
    "configuration": {
      "title": "Agntree",
      "properties": {
        "agntree.autoSwitchWorkspaceFolder": {
          "type": "boolean",
          "default": false,
          "description": "Automatically switch VS Code's workspace folder when selecting a worktree or session from a different repository. Disable this to prevent the flickering caused by extension host restart."
        },
        "agntree.focusOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Focus the Agntree panel automatically when VS Code starts, instead of the default File Explorer."
        },
        "agntree.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a VS Code notification when a session stops working."
        },
        "agntree.notifications.onTurnEnd": {
          "type": "boolean",
          "default": true,
          "description": "Notify when a session finishes responding."
        },
        "agntree.notifications.onNeedsInput": {
          "type": "boolean",
          "default": true,
          "description": "Notify when a Claude Code session is waiting on you (a permission prompt or an idle question). Reads `claude agents --json`, which requires Claude Code 2.1.310 or newer. No hooks are used."
        },
        "agntree.notifications.nativeBanner": {
          "type": "boolean",
          "default": true,
          "description": "On macOS, also show a notification banner while VS Code is not focused. The banner cannot be clicked; the VS Code notification carries the Open action."
        },
        "agntree.harnessCommands": {
          "type": "object",
          "default": {
            "claude": "claude",
            "opencode": "opencode",
            "codex": "codex"
          },
          "properties": {
            "claude": {
              "type": "string",
              "description": "Command used to launch Claude Code (default: claude)."
            },
            "opencode": {
              "type": "string",
              "description": "Command used to launch opencode (default: opencode)."
            },
            "codex": {
              "type": "string",
              "description": "Command used to launch Codex (default: codex)."
            }
          },
          "additionalProperties": false,
          "description": "Override the CLI command for each harness, e.g. when it is not on PATH or you use a wrapper."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "agntree.addRepository",
          "when": "view == agntree.workspacesView",
          "group": "navigation@1"
        },
        {
          "command": "agntree.cloneRepository",
          "when": "view == agntree.workspacesView",
          "group": "1_actions@1"
        },
        {
          "command": "agntree.searchSessions",
          "when": "view == agntree.workspacesView",
          "group": "1_actions@2"
        },
        {
