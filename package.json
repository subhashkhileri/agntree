          "group": "inline"
        },
        {
          "command": "agntree.stageFile",
          "when": "view == agntree.changesView && viewItem == unstagedFile",
          "group": "navigation"
        },
        {
          "command": "agntree.discardFile",
          "when": "view == agntree.changesView && viewItem == unstagedFile",
          "group": "destructive"
        },
        {
          "command": "agntree.unstageFile",
          "when": "view == agntree.changesView && viewItem == stagedFile",
          "group": "navigation"
        },
        {
          "command": "agntree.files.openToSide",
          "when": "view == agntree.filesView && viewItem == file",
          "group": "1_open@1"
        },
        {
          "command": "agntree.files.revealInFinder",
          "when": "view == agntree.filesView && (viewItem == file || viewItem == folder)",
          "group": "2_reveal@1"
        },
        {
          "command": "agntree.files.openInTerminal",
          "when": "view == agntree.filesView && (viewItem == file || viewItem == folder)",
          "group": "2_reveal@2"
        },
        {
          "command": "agntree.files.copyPath",
          "when": "view == agntree.filesView && (viewItem == file || viewItem == folder)",
          "group": "3_path@1"
        },
        {
          "command": "agntree.files.copyRelativePath",
          "when": "view == agntree.filesView && (viewItem == file || viewItem == folder)",
          "group": "3_path@2"
        },
        {
          "command": "agntree.files.copy",
          "when": "view == agntree.filesView && (viewItem == file || viewItem == folder)",
          "group": "4_clipboard@1"
        },
        {
          "command": "agntree.files.cut",
          "when": "view == agntree.filesView && (viewItem == file || viewItem == folder)",
          "group": "4_clipboard@2"
        },
        {
          "command": "agntree.files.paste",
          "when": "view == agntree.filesView && (viewItem == folder || viewItem == file) && agntree.hasFileClipboard",
          "group": "4_clipboard@3"
        },
        {
          "command": "agntree.files.newFile",
          "when": "view == agntree.filesView && viewItem == folder",
          "group": "5_create@1"
        },
        {
          "command": "agntree.files.newFolder",
          "when": "view == agntree.filesView && viewItem == folder",
          "group": "5_create@2"
        },
        {
          "command": "agntree.files.rename",
          "when": "view == agntree.filesView && (viewItem == file || viewItem == folder)",
          "group": "6_edit@1"
        },
        {
          "command": "agntree.files.delete",
          "when": "view == agntree.filesView && (viewItem == file || viewItem == folder)",
          "group": "6_edit@2"
        }
      ],
      "agntree.newSession": [
        {
          "command": "agntree.newClaudeChat",
          "when": "agntree.claudeInstalled",
          "group": "1_harness@1"
        },
        {
          "command": "agntree.newOpencodeChat",
          "when": "agntree.opencodeInstalled",
          "group": "1_harness@2"
        },
        {
          "command": "agntree.newCodexChat",
          "when": "agntree.codexInstalled",
          "group": "1_harness@3"
        }
      ],
      "agntree.newSessionContext": [
        {
          "command": "agntree.newClaudeChat",
          "when": "agntree.claudeInstalled",
          "group": "1_harness@1"
        },
        {
          "command": "agntree.newOpencodeChat",
          "when": "agntree.opencodeInstalled",
          "group": "1_harness@2"
        },
        {
          "command": "agntree.newCodexChat",
          "when": "agntree.codexInstalled",
          "group": "1_harness@3"
        }
      ],
      "commandPalette": [
        {
          "command": "agntree.moveRepositoryUp",
          "when": "false"
        },
        {
          "command": "agntree.moveRepositoryDown",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "generate:icons": "node scripts/generate-harness-icons.mjs",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run test:dry",
    "test:dry": "node test/dry/run.js",
    "test:integration": "npm run compile && node test/integration/runTest.js",
    "test:e2e": "npm run compile && node test/e2e/terminal-restore/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^2.3.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  }
}
