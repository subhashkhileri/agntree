{
  "name": "agntree",
  "displayName": "Agntree — Agent Session & Worktree Manager",
  "description": "Session manager for coding agents. Resume, fork, search, and organize Claude Code, opencode, and Codex sessions across git worktrees. Built-in changes panel and PR checkout. Works with VS Code and Cursor.",
  "version": "2.0.1",
  "publisher": "subhashkhileri",
  "author": {
    "name": "Subhash Khileri",
    "url": "https://github.com/subhashkhileri"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/subhashkhileri/agntree.git"
  },
  "bugs": {
    "url": "https://github.com/subhashkhileri/agntree/issues"
  },
  "homepage": "https://subhashkhileri.github.io/agntree",
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Machine Learning",
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "claude code",
    "claude",
    "opencode",
    "codex",
    "claude code session manager",
    "claude code worktree",
    "claude session",
    "opencode session",
    "anthropic",
    "ai coding agent",
    "ai coding harness",
    "session manager",
    "git worktree",
    "worktree manager",
    "cursor",
    "ai coding",
    "copilot",
    "cline",
    "aider",
    "windsurf",
    "session forking",
    "multi-repo",
    "developer tools",
    "ai assistant"
  ],
  "icon": "resources/icons/agntree.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agntree",
          "title": "Agntree",
          "icon": "resources/icons/agntree.svg"
        }
      ]
    },
    "views": {
      "agntree": [
        {
          "id": "agntree.workspacesView",
          "name": "Workspaces",
          "size": 4
        },
        {
          "id": "agntree.changesView",
          "name": "Changes",
          "size": 2
        },
        {
          "id": "agntree.filesView",
          "name": "All Files",
          "size": 3
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agntree.workspacesView",
        "contents": "Start managing your Claude Code, opencode, and Codex sessions across folders, repositories, and worktrees.\n\n[Add Local Folder or Repository](command:agntree.addRepository)\n[Clone from GitHub](command:agntree.cloneRepository)\n\nAdd any local folder, or clone a repository from GitHub to get started."
      },
      {
        "view": "agntree.changesView",
        "contents": "Select a worktree, folder, or session to view uncommitted changes.\n\nClick the diff icon on any file to view side-by-side comparison."
      },
      {
        "view": "agntree.filesView",
        "contents": "Select a worktree, folder, or session to browse its files."
      }
    ],
    "commands": [
      {
        "command": "agntree.files.search",
        "title": "Search in Files",
